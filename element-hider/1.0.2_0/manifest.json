{
   "action": {
      "default_icon": "icons/icon.png",
      "default_popup": "src/browser_action/popup.html",
      "default_title": "ElementHider"
   },
   "background": {
      "service_worker": "bg.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "elementhider@vh",
         "strict_min_version": "109.0"
      }
   },
   "content_scripts": [ {
      "js": [ "src/browser_action/jquery.min.js", "src/shared/keywordUtils.js", "src/inject/inject.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_start"
   } ],
   "description": "Hides elements that contain keywords set by user",
   "homepage_url": "https://addons.mozilla.org/firefox/addon/elementhider-vh/",
   "host_permissions": [ "*://*/*" ],
   "icons": {
      "128": "icons/icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ElementHider",
   "options_ui": {
      "page": "src/browser_action/KeywordEditor.html"
   },
   "permissions": [ "storage", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "src/browser_action/guide.html", "src/browser_action/css/guide.css" ]
   } ]
}
